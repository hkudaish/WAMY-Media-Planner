NODE_ENV=production
HOST=0.0.0.0
PORT=5173
PUBLIC_ORIGIN=https://planner.example.org
ALLOWED_ORIGINS=https://planner.example.org
TRUST_PROXY=1
DATABASE_URL=postgresql://wamy_app:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@postgres:5432/wamy_media
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_PASSWORD
APP_DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=15000
BOOTSTRAP_ADMIN_TOKEN=REPLACE_WITH_A_LONG_ONE_TIME_RANDOM_TOKEN
ALLOW_PUBLIC_SIGNUP=false
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_HOURS=6
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
BACKUP_ALERT_WEBHOOK=
# BACKUP_COPY_DIR=/offsite-backups
OFFSITE_BACKUP_PATH=/srv/wamy-offsite-backups
